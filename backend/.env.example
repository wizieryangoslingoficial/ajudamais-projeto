# Copie este arquivo para .env (no CMD: copy .env.example .env)
# e ajuste apenas DB_PASSWORD com a senha do usuário criado no MySQL.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ajudamais
DB_PASSWORD=a_senha_que_voce_definiu
DB_NAME=ajudamais

# Bancos gratuitos na nuvem (Aiven, Railway) costumam exigir TLS:
# DB_SSL=true

# Porta do servidor. O Express também entrega o site (frontend/), então basta
# abrir http://localhost:3000 depois de "npm start".
PORT=3000

# Em desenvolvimento pode ficar *. Em produção, informe a origem do site.
CORS_ORIGIN=*

# Opcionais
SESSION_DAYS=30
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
