{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "buildCommand": "",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/favicon.ico", "destination": "/api/index.js" }
  ]
}
